# Keep model and plotting caches inside the project when the home cache is not writable.
HF_HOME=.hf_cache
HF_DATASETS_CACHE=.hf_cache/datasets
MPLCONFIGDIR=.mpl_cache
XDG_CACHE_HOME=.cache
TOKENIZERS_PARALLELISM=false
PYTORCH_ENABLE_MPS_FALLBACK=1

# Local smoke-test default. This is a 14M-parameter decoder-only model.
SMOKE_MODEL_ID=EleutherAI/pythia-14m
